diff --git a/init/main.c b/init/main.c
index c0117704a..aa1965fdf
--- a/init/main.c
+++ b/init/main.c
@@ -103,6 +103,9 @@
 #define CREATE_TRACE_POINTS
 #include <trace/events/initcall.h>
 
+/* selene: boot ilerlemesini expdb'ye yazdirmak icin (bkz. dosya basi) */
+#include <mt-plat/mboot_params.h>
+
 static int kernel_init(void *);
 
 extern void init_IRQ(void);
@@ -692,6 +695,9 @@ asmlinkage __visible void __init start_kernel(void)
 	 * this. But we do want output early, in case something goes wrong.
 	 */
 	console_init();
+	/* selene: AEE RAM console bu noktada kayitli; izler buradan itibaren
+	 * calisiyor. Daha oncesi icin bu API'ler sessizce geri donuyor. */
+	aee_rr_rec_fiq_step(0xA0);
 	if (panic_later)
 		panic("Too many boot %s vars at `%s'", panic_later,
 		      panic_param);
@@ -768,6 +774,8 @@ asmlinkage __visible void __init start_kernel(void)
 	}
 
 	/* Do the rest non-__init'ed, we're now alive */
+	/* selene: start_kernel'in sonu -- buradan sonrasi rest_init */
+	aee_rr_rec_fiq_step(0xA1);
 	rest_init();
 
 	prevent_tail_call_optimization();
@@ -919,6 +927,10 @@ int __init_or_module do_one_initcall(initcall_t fn)
 	if (initcall_blacklisted(fn))
 		return -EPERM;
 
+	/* selene: son calisan initcall'in adresi. Cihaz burada olurse
+	 * expdb'de bu adres kalir; System.map ile fonksiyon adina cevrilir. */
+	aee_rr_rec_last_init_func((unsigned long)fn);
+
 	do_trace_initcall_start(fn);
 	BOOTPROF_TIME_LOG_START(ts);
 	ret = fn();
@@ -1122,8 +1134,16 @@ static int __ref kernel_init(void *unused)
 
 	bootprof_log_boot("Kernel_init_done");
 
+	/* selene: kernel isini bitirdi, userspace'e geciliyor */
+	aee_rr_rec_fiq_step(0xA5);
+
 	if (ramdisk_execute_command) {
+		/* selene: exec cagrilmak uzere. Bu deger SON deger olarak kalirsa
+		 * exec basarili olmus ve userspace baslamistir. */
+		aee_rr_rec_fiq_step(0xA6);
 		ret = run_init_process(ramdisk_execute_command);
+		/* selene: buraya donmek exec'in BASARISIZ oldugu anlamina gelir */
+		aee_rr_rec_fiq_step(0xA7);
 		if (!ret)
 			return 0;
 		pr_err("Failed to execute %s (error %d)\n",
@@ -1186,6 +1206,9 @@ static noinline void __init kernel_init_freeable(void)
 	/* Initialize page ext after all struct pages are initialized. */
 	page_ext_init();
 
+	/* selene: initcall'lar simdi kosacak; hangisinde olundugu
+	 * last_init_func alanindan okunur */
+	aee_rr_rec_fiq_step(0xA2);
 	do_basic_setup();
 
 	/* Open the /dev/console on the rootfs, this should never fail */
